# Copy this file to `.env` (same folder) and fill in your real values.
# `.env` is ignored by git, so your values never end up in the repo.
#
# Where to find the two Supabase values:
#   supabase.com  ->  your project  ->  Settings  ->  API
#     Project URL                   -> EXPO_PUBLIC_SUPABASE_URL
#     Publishable (anon) key        -> EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# The publishable key is MEANT to ship inside the app — it is not a
# secret. What keeps each person's data private is Row Level Security
# in the database, which is switched on for every table (sql/01).
#
# Never put the `service_role` / secret key in here. That one bypasses
# every security rule and must never touch the app.
#
# The EXPO_PUBLIC_ prefix is required — Expo only exposes variables
# with that prefix to app code.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# RevenueCat — app.revenuecat.com -> your project -> API keys.
# Optional while developing: leave these out and the app uses
# RevenueCat's Test Store, which fakes purchases.
#   iPhone  -> starts with appl_
#   Android -> starts with goog_ (Google Play)
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Copy this file to `.env` (same folder) and fill in your real values.
#
# Where to find the two Supabase values:
#   supabase.com  ->  your project  ->  Settings  ->  API
#     Project URL          -> EXPO_PUBLIC_SUPABASE_URL
#     Project API keys  ->  anon / public  -> EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# The anon key is MEANT to ship inside the app — it is not a secret.
# What keeps your data private is Row Level Security in the database,
# which is already switched on for every table.
#
# Never put the `service_role` key in here. That one bypasses every
# security rule and must never touch the app.
#
# The EXPO_PUBLIC_ prefix is required — Expo only exposes variables
# with that prefix to app code.

EXPO_PUBLIC_SUPABASE_URL=https://prhanpllqeogvvovefgn.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Eue2F3OKXVfYoGNGWT51bQ_iyp2KJ3C

# From app.revenuecat.com -> your project -> API keys.
# Galaxy Store keys start with galx_. A key starting with test_ is the
# RevenueCat Test Store, which is what to use while you have no Galaxy
# device to hand.
EXPO_PUBLIC_REVENUECAT_KEY=test_umYsfeNmcyutWfLAaWrYnnOwuzy
